ze:11px;padding:3px 10px;letter-spacing:0.1em}\n  /* FAQ */\n  .faq-group{margin-bottom:28px}\n  .faq-group h3{border-bottom:1px solid var(--line);padding-bottom:6px;margin-bottom:12px}\n  .faq-item{margin-bottom:14px}\n  .faq-item .q{font-weight:600;color:var(--wine-dark);margin-bottom:4px}\n  .faq-item .q::before{content:\"问  \";color:var(--muted);font-weight:400}\n  .faq-item .a{color:var(--ink);opacity:0.9;padding-left:22px}\n  /* CLIENTS / USAGE */\n  .steps{list-style:none;counter-reset:step;padding:0}\n  .steps li{counter-increment:step;padding:14px 0 14px 48px;border-bottom:1px dashed var(--line);position:relative}\n  .steps li::before{content:counter(step,decimal-leading-zero);position:absolute;left:0;top:14px;font-weight:700;color:var(--wine);font-size:13px;letter-spacing:0.1em}\n  .note{font-size:13px;color:var(--muted);margin-top:8px}\n  .footer{padding:40px 0 60px;text-align:center;font-size:12px;color:var(--muted);letter-spacing:0.08em}\n  @media (max-width:720px){\n    .plan-step.s1,.plan-step.s2,.plan-step.s3{max-width:100%;margin:0 auto 18px}\n    .hero .toplinks{margin-bottom:32px}\n  }\n</style><header class=\"hero\">\n  <div class=\"toplinks\">\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#usage\">使用</a>\n    <a href=\"#faq\">常见问题</a>\n    <a href=\"#terms\">条款</a>\n  </div>\n  <h1>跑路机场</h1>\n  <div class=\"subtitle\">一个务实的网络中转订阅服务，按月或按年付费，按量计费，不打包套路。</div>\n  <div class=\"bottomlinks\">\n    <a href=\"#plans\">查看三档套餐</a>\n    <a href=\"#usage\">四步接入说明</a>\n    <a href=\"#faq\">订阅、退款、节点与稳定性 FAQ</a>\n  </div>\n</header>\n\n<main>\n\n<section class=\"sec\" id=\"intro\">\n  <div class=\"wrap\">\n    <h2>关于跑路机场</h2>\n    <p>跑路机场提供月付与年付两种结算方式，套餐分为基础版、旗舰版与团队版三档。所有套餐均以流量为计价单位，不承诺无限流量，也不在套餐里塞无关增值服务。页面上的每一项权益都与下方价格表一一对应，下单前请确认所选套餐满足你的使用场景。</p>\n    <p class=\"anchor\">本页内容：<a href=\"#plans\">套餐价格</a> · <a href=\"#usage\">使用说明</a> · <a href=\"#faq\">常见问题</a> · <a href=\"#terms\">服务条款</a></p>\n  </div>\n</section>\n\n<section class=\"sec\" id=\"plans\">\n  <div class=\"wrap\">\n    <h2>套餐与价格</h2>\n    <p>三档套餐按流量、设备数与节点池递进排列，年付均按月付价格的十个月计算。</p>\n\n    <div class=\"plans\">\n      <article class=\"plan-step s1\">\n        <div class=\"tag\">入门档</div>\n        <div class=\"name\">基础版</div>\n        <div class=\"price\">¥15 / 月</div>\n        <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n        <ul>\n          <li>每月 100GB 流量额度</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>覆盖常见流媒体区域解锁</li>\n          <li>接入普通线路节点池</li>\n          <li>邮件工单响应</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-step s2\">\n        <div class=\"featured\">推荐</div>\n        <div class=\"tag\">主力档</div>\n        <div class=\"name\">旗舰版</div>\n        <div class=\"price\">¥35 / 月</div>\n        <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n        <ul>\n          <li>每月 300GB 流量额度</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线，针对游戏加速做路由优化</li>\n          <li>7×24 小时优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-step s3\">\n        <div class=\"tag\">团队档</div>\n        <div class=\"name\">团队版</div>\n        <div class=\"price\">¥85 / 月</div>\n        <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n        <ul>\n          <li>每月 1000GB 流量额度</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点池</li>\n          <li>支持企业定制路由与出口策略</li>\n          <li>专属客户经理对接</li>\n        </ul>\n      </article>\n    </div>\n    <p class=\"note\">价格为页面展示参考，最终以下单页面为准。流量按自然月重置，不结转。</p>\n  </div>\n</section>\n\n<section class=\"sec\" id=\"usage\">\n  <div class=\"wrap\">\n    <h2>使用说明</h2>\n    <p>从下单到首次连接，按下面四步操作即可完成接入。未提供官方客户端，请使用通用协议客户端导入订阅。</p>\n    <ol class=\"steps\">\n      <li>选择套餐并完成付款，系统自动开通账户并生成专属订阅地址。</li>\n      <li>登录用户后台，复制「订阅地址」，地址形如 https://portal.example/sub/your-token。</li>\n      <li>在你的客户端中选择「从 URL 导入订阅」或「更新订阅」，粘贴地址并更新节点列表。</li>\n      <li>选择任一节点，连接后即可使用。节点池会自动更新，无需手动重装配置。</li>\n    </ol>\n    <div class=\"ticket\">\n      <div class=\"meta\">客户端兼容</div>\n      <h3>支持的客户端范围</h3>\n      <ul>\n        <li>Windows / macOS：使用支持订阅导入的通用客户端即可。</li>\n        <li>Android：推荐使用支持订阅格式的主流客户端。</li>\n        <li>iOS：App Store 区服可用的通用客户端均可导入。</li>\n        <li>路由器：支持订阅解析的固件可直接填入订阅地址。</li>\n      </ul>\n      <p class=\"note\">本服务不提供官方客户端，不提供下载链接，请自行选择可信客户端。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"sec\" id=\"faq\">\n  <div class=\"wrap\">\n    <h2>常见问题</h2>\n\n    <div class=\"faq-group\">\n      <h3>订阅与开通</h3>\n      <div class=\"faq-item\">\n        <div class=\"q\">下单后多久能拿到订阅地址？</div>\n        <div class=\"a\">付款完成后系统自动开通，订阅地址会在用户后台「订阅」页面显示，通常在几分钟内可用。</div>\n      </div>\n      <div class=\"faq-item\">\n        <div class=\"q\">流量是按月重置还是按天计算？</div>\n        <div class=\"a\">按自然月重置。每月 1 日会将流量计数归零，未用完的部分不结转到下月。</div>\n      </div>\n      <div class=\"faq-item\">\n        <div class=\"q\">年付和月付的流量额度一样吗？</div>\n        <div class=\"a\">一样。年付只是把月付价格按十个月结算，每月流量额度与月付一致。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>设备与并发</h3>\n      <div class=\"faq-item\">\n        <div class=\"q\">一台设备算一个并发吗？</div>\n        <div class=\"a\">是。同一账户同时连接的设备数不能超过套餐上限，超出会被系统拒绝连接。</div>\n      </div>\n      <div class=\"faq-item\">\n        <div class=\"q\">可以换设备使用吗？</div>\n        <div class=\"a\">可以。旧设备断开后，新设备即可连接，只要同时在线数不超过套餐限制。</div>\n      </div>\n      <div class=\"faq-item\">\n        <div class=\"q\">团队版 20 台设备是否支持分配？</div>\n        <div class=\"a\">团队版支持为不同成员生成独立子账户，并在后台统一查看用量与设备数。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>退款与稳定</h3>\n      <div class=\"faq-item\">\n        <div class=\"q\">试用期内可以退款吗？</div>\n        <div class=\"a\">开通后 24 小时内、且累计使用流量不超过 1GB，可申请全额退款；超出后不再支持退款。</div>\n      </div>\n      <div class=\"faq-item\">\n        <div class=\"q\">节点不稳定可以换套餐或换节点池吗？</div>\n        <div class=\"a\">可以在套餐有效期内切换节点，节点池会自动更新；如需升级到更高档套餐，可补差价升级。</div>\n      </div>\n      <div class=\"faq-item\">\n        <div class=\"q\">流量用完了还能继续使用吗？</div>\n        <div class=\"a\">不能。流量用完后连接会被暂停，可购买流量加油包或等待次月 1 日重置。</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sec\" id=\"terms\">\n  <div class=\"wrap\">\n    <h2>服务条款摘要</h2>\n    <div class=\"ticket\">\n      <div class=\"meta\">务须知道</div>\n      <ul>\n        <li>套餐价格、流量额度、设备数以本页展示为准，如遇调整以用户后台公告为准。</li>\n        <li>本服务仅提供网络中转订阅，不提供任何内容、不存储任何用户访问数据。</li>\n        <li>禁止用于任何违反所在地法律法规的用途，违规账户将被停用且不退款。</li>\n        <li>年付订单在有效期内的停用，按未使用月份折算退款，已使用月份按月付价格扣除。</li>\n      </ul>\n    </div>\n    <p class=\"anchor\">继续了解：<a href=\"#plans\">回到套餐</a> · <a href=\"#usage\">使用说明</a> · <a href=\"#faq\">常见问题</a></p>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"footer\">\n  <div class=\"wrap\">跑路机场 · 本页内容为服务说明展示，不构成交易要约</div>\n</footer>",
